{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/tool session start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/tool session received",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/tool session stop --harness {{harness}} --event {{event}}",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/scripts/tool session notify" }]
      }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/scripts/tool session end" }] }
    ]
  }
}
