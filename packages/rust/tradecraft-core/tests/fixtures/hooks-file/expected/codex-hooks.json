{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "${PLUGIN_ROOT}/scripts/tool session end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${PLUGIN_ROOT}/scripts/tool session start",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${PLUGIN_ROOT}/scripts/tool session stop --harness codex --event Stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "${PLUGIN_ROOT}/scripts/tool session received",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
