{
  "name": "@osdlc/markdown-db",
  "version": "0.0.0",
  "private": true,
  "description": "Validator for markdown-db corpora: typed records kept as Markdown, YAML and JSON files in a folder, checked against the schemas and links the folder holds.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/skillwright.git",
    "directory": "packages/ts/markdown-db"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "markdown-db": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osdlc/frontmatter-lossless": "1.1.2",
    "@osdlc/markdown-link": "0.8.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "^0.3.1",
    "@osdlc/tsconfig": "^0.4.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
