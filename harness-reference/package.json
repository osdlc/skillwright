{
  "name": "harness-reference",
  "private": true,
  "type": "module",
  "description": "A versioned, cited record of how coding-agent harnesses differ, kept as one Markdown corpus, with its tools.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "corpus-schema validate corpus",
    "capture": "node src/corpus/capture.ts",
    "lint": "node src/corpus/lint.ts",
    "compile": "node src/compile/compile.ts",
    "test": "node --test src/*/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run validate && pnpm run lint && pnpm run test && pnpm run typecheck"
  },
  "dependencies": {
    "@osdlc/corpus-schema": "^0.2.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
